{
    "manifest_version": 3,
    "name" : "Poké Context Ball",
    "version" : "1.0.0",

    "description" : "A Capsule like thing which can be used to Transfer Context Memory from one LLM to another.",

    "icons": {
        "16": "icons/pokeball-16.png",
        "32": "icons/pokeball-32.png",
        "48": "icons/pokeball-48.png",
        "128": "icons/pokeball-128.png"
    },

    "action" : {
        "default_popup" : "src/ui/popup/popup.html",
        "default_icon": {
            "16": "icons/pokeball-16.png",
            "32": "icons/pokeball-32.png",
            "48": "icons/pokeball-48.png",
            "128": "icons/pokeball-128.png"
        }
    },

    "background" : {
        "scripts": ["src/background/service-worker.ts"],
        "type": "module"
    },

    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://gemini.google.com/*",
                "https://chat.deepseek.com/*",
                "https://claude.ai/*"
            ],
            "js": ["src/content/conversation-capture.ts"]
        }
    ],

    "permissions" : [
        "storage",
        "scripting",
        "activeTab"
    ],

    "host_permissions": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://openrouter.ai/*"
    ],
    
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },


    "browser_specific_settings": {
        "gecko": {
            "id": "poke-context-ball@nerdswayam.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}